# --- Anthropic (required) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
# Optional tuning
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_EFFORT=high            # low | medium | high | xhigh | max
# ANTHROPIC_THINKING=adaptive      # adaptive | none
# ANTHROPIC_TIMEOUT_SECONDS=120
# Retries with exponential backoff on 429 / 5xx / 529 / timeouts (the SDK's own retries are off)
# ANTHROPIC_MAX_RETRIES=3

# --- Target repository ---
REPO_PATH=workspaces/sample-repo
# python, javascript or java. auto (the default) looks at REPO_PATH for pyproject.toml, setup.py,
# setup.cfg or requirements.txt, then package.json, then pom.xml. The language picks the default
# test command, allowlist, sandbox image and fixture issues file (all can be set below).
PROJECT_LANGUAGE=auto
# Comma-separated directories the agent may modify (empty = whole repository).
# For the bundled samples: authkit,tests (Python), src,test (JavaScript), src (Java)
WRITABLE_PATHS=authkit,tests
ALLOW_NEW_FILES=true

# --- GitHub ---
# fixture: read issues from GITHUB_ISSUES_FILE (no network); api: GitHub REST API
GITHUB_MODE=fixture
GITHUB_REPOSITORY=demo/sample-repo
# Default: the bundled sample's issues for PROJECT_LANGUAGE (examples/issues/sample-repo.json,
# sample-repo-js.json or sample-repo-java.json)
# GITHUB_ISSUES_FILE=examples/issues/sample-repo.json
# Fine-grained token for this one repository only:
#   Metadata: read, Issues: read, Contents: read & write (push), Pull requests: read & write
# (Issues: read alone is enough if you never publish; optional for public repos in that case.)
# GITHUB_TOKEN=
# GitHub Enterprise Server only (defaults: https://api.github.com and https://github.com)
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# --- Publishing ---
GITHUB_DEFAULT_BRANCH=main
# New branches must start with this prefix (empty disables the rule)
GITHUB_BRANCH_PREFIX=agent/
GITHUB_PR_DRAFT=true
GIT_AUTHOR_NAME=MCP Coding Agent
GIT_AUTHOR_EMAIL=mcp-coding-agent@users.noreply.github.com

# --- Documentation reader ---
# Read-only access to the sources in DOCS_SOURCES_FILE (https only, GET only, no logins)
DOCS_ENABLED=true
DOCS_SOURCES_FILE=config/docs_sources.json
DOCS_TIMEOUT_SECONDS=15
DOCS_MAX_PAGE_BYTES=2000000
# Network requests per server session (one run step); search indexes are cached on disk
DOCS_MAX_FETCHES=40
DOCS_RESPECT_ROBOTS=true
DOCS_CACHE_TTL_SECONDS=86400

# --- Sandbox (Docker) ---
# Default by language: mcp-agent-sandbox:latest (sandbox/), mcp-agent-sandbox-js:latest
# (sandbox/javascript/), mcp-agent-sandbox-java:latest (sandbox/java/)
# SANDBOX_IMAGE=mcp-agent-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256
# Where repository copies for test runs are made (default: the system temp directory).
# With docker compose this must be the same path on the host and in the api container.
# SANDBOX_WORK_DIR=/tmp/mcp-agent-sandbox
# Defaults by language:
#   python      TEST_COMMAND=pytest -q -p no:cacheprovider   TEST_COMMAND_ALLOWLIST=pytest,python -m pytest
#   javascript  TEST_COMMAND=node --test --test-reporter=tap  TEST_COMMAND_ALLOWLIST=node --test
#   java        TEST_COMMAND=mvn -o -B test                   TEST_COMMAND_ALLOWLIST=mvn
# TEST_COMMAND=pytest -q -p no:cacheprovider
# TEST_COMMAND_ALLOWLIST=pytest,python -m pytest

# --- Workflow limits ---
# Every tool call the model requests in one step counts, rejected ones included
MAX_TOOL_CALLS_PER_STEP=25
MAX_FIX_ATTEMPTS=2
MAX_REVISIONS=2

# --- Reliability ---
# Run budget, across every resume and retry of a run (0 disables a limit)
MAX_TASK_COST_USD=5.00
MAX_LLM_CALLS_PER_RUN=100
MAX_TOOL_CALLS_PER_RUN=150
# Prices in USD per million tokens. Read from MODEL_PRICES_FILE unless input and output are set here.
MODEL_PRICES_FILE=config/model_prices.json
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# LLM_PRICE_CACHE_READ_PER_MTOK=
# LLM_PRICE_CACHE_WRITE_PER_MTOK=
# Per-call deadline for the GitHub and filesystem servers (docs and sandbox derive theirs)
TOOL_TIMEOUT_SECONDS=60
# Retries of temporary tool errors, for read-only and idempotent tools only
TOOL_MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30
# How many times a failed or interrupted run may be retried (POST /runs/{id}/retry)
MAX_RUN_RETRIES=3
# Pause for a human to approve the plan before any investigation
REQUIRE_PLAN_APPROVAL=false

# --- Storage ---
DATA_DIR=data

# --- UI ---
# Where the Streamlit UI finds the API
# AGENT_API_URL=http://127.0.0.1:8000

# --- Docker Compose only (read by docker-compose.yml, not by the app) ---
# Match your user so the containers can use git on the mounted repository: id -u / id -g
# UID=1000
# GID=1000
# Group that owns the Docker socket on the host (Linux: stat -c %g /var/run/docker.sock)
# DOCKER_GID=0
