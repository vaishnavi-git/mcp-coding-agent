{
  "components": {
    "schemas": {
      "ApprovalDecision": {
        "description": "One answer for every checkpoint kind (see pending_approval.kind in GET /runs/{id}):\n\n- plan_approval / patch_approval / publish_approval: approve, or reject (with feedback to revise).\n- recovery: approved=true retries (one more fix attempt, or re-running the tests), false stops the run.",
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "edits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublicationEdits"
              },
              {
                "type": "null"
              }
            ],
            "description": "Publication checkpoints only: values to use instead of the draft"
          },
          "feedback": {
            "default": "",
            "description": "Revision request after a rejection, or guidance for the next fix attempt at a recovery checkpoint",
            "maxLength": 4000,
            "title": "Feedback",
            "type": "string"
          },
          "publish_up_to": {
            "anyOf": [
              {
                "enum": [
                  "branch",
                  "push",
                  "pull_request"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Publication checkpoints only: how far to go (default pull_request when approved)",
            "title": "Publish Up To"
          }
        },
        "required": [
          "approved"
        ],
        "title": "ApprovalDecision",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PublicationEdits": {
        "properties": {
          "branch_name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Branch Name"
          },
          "commit_message": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Message"
          },
          "pr_body": {
            "anyOf": [
              {
                "maxLength": 60000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Body"
          },
          "pr_title": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Title"
          }
        },
        "title": "PublicationEdits",
        "type": "object"
      },
      "StartRunRequest": {
        "properties": {
          "instructions": {
            "default": "",
            "description": "Optional extra guidance for the agent",
            "maxLength": 2000,
            "title": "Instructions",
            "type": "string"
          },
          "issue_number": {
            "description": "GitHub issue number to resolve",
            "exclusiveMinimum": 0.0,
            "title": "Issue Number",
            "type": "integer"
          }
        },
        "required": [
          "issue_number"
        ],
        "title": "StartRunRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Resolve GitHub issues through MCP servers with human approval before any file change.",
    "title": "MCP Coding Agent",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/runs": {
      "get": {
        "operationId": "list_runs_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Runs Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List recent runs"
      },
      "post": {
        "operationId": "start_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Start Run Runs Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start resolving an issue"
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Run Runs  Run Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run state: plan, proposals, diff, tests, failure, usage against limits, retry"
      }
    },
    "/runs/{run_id}/approval": {
      "post": {
        "operationId": "decide_runs__run_id__approval_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecision"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Decide Runs  Run Id  Approval Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Answer the pending checkpoint (plan, patch, recovery or publication)"
      }
    },
    "/runs/{run_id}/audit": {
      "get": {
        "operationId": "audit_runs__run_id__audit_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Audit Runs  Run Id  Audit Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tool calls, LLM call metadata and workflow events"
      }
    },
    "/runs/{run_id}/retry": {
      "post": {
        "operationId": "retry_runs__run_id__retry_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Retry Runs  Run Id  Retry Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Continue a failed or interrupted run from the step that failed"
      }
    },
    "/tools": {
      "get": {
        "operationId": "tools_tools_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Tools Tools Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Discover the tools exposed by the connected MCP servers"
      }
    }
  }
}
